generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Photo {
  id          String   @id @default(cuid())
  url         String
  thumbnailUrl String?
  blurDataUrl String?
  fileSize    Int?
  width       Int
  height      Int

  // Basic metadata
  title       String
  description String   @default("")

  // EXIF data
  make              String?
  model             String?
  lensModel         String?
  focalLength       Float?
  focalLength35mm   Float?
  fNumber           Float?
  iso               Int?
  exposureTime      Float?
  exposureCompensation Float?
  dateTimeOriginal  DateTime?
  gpsAltitude       Float?

  // Location
  latitude      Float?
  longitude     Float?
  country       String?
  countryCode   String?
  region        String?
  city          String?
  district      String?
  fullAddress   String?
  placeFormatted String?

  // Status
  isFavorite  Boolean  @default(false)
  rating      Int      @default(0)

  // AI metadata (silently stored for future use)
  category    String?
  tags        String?

  // SEO: unique URL slug for photo detail page
  slug        String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Indexes ──────────────────────────────────────────────────────────
  // Every one of these backs a query that runs on page load. Without them SQLite
  // scans the whole table and sorts in memory for each.
  //
  //   [createdAt]       list with no filter — the SSR first screen and the
  //                     infinite-scroll endpoint, both `orderBy createdAt desc`
  //   [city, createdAt]      `where { city }` + the same ordering, plus its count()
  //   [category, createdAt]  `where { category }` + the same ordering, and the
  //                          sidebar's `groupBy(["category"])`
  //   [country, city]        the sidebar's `groupBy(["country", "city"])`
  //   [dateTimeOriginal]     the map page: `orderBy dateTimeOriginal desc`, take 200
  @@index([createdAt])
  @@index([city, createdAt])
  @@index([category, createdAt])
  @@index([country, city])
  @@index([dateTimeOriginal])
}
